# Backend API Base URL (ASP.NET Core Backend)
API_URL=http://localhost:5048/api
NG_APP_API_URL=http://localhost:5048/api

# Frontend Dev Server Settings
PORT=4200
HOST=localhost

# Application Mode (development | production)
NODE_ENV=development
